// live-config.example.json — TEMPLATE, not read by the bot.
//
// How to use:
//   1. Copy this file to `live-config.json` in the project root.
//   2. Strip out the comment lines (JSON does not support comments —
//      this template uses them for documentation only; the real
//      live-config.json must be valid JSON).
//   3. Adjust values to your strategy, or leave as-is and tune later
//      via Telegram `/set <path> <value>` (persists back to this file).
//   4. If you skip this step entirely, the bot auto-creates
//      live-config.json with these same defaults on first run.
//
// live-config.json holds ALL management settings (trading, TP/SL, trailing,
// LLM tuning, Darwin tuning, telegram, monitor). It does NOT hold screener
// filters, GMGN section, llm.enabled, or darwin.enabled/autoEvolve — those
// are strategy-owned and live in strategy.json (copy strategy.example.json
// to get started), selected via the `strategy` field below.
// paper-config.json only overrides a few paper-mode-specific fields on top
// of this file.
{
  // Trading strategy preset — selects screener.filters, screener.section,
  // llm.enabled and darwin.enabled/autoEvolve from strategy.json. Management
  // settings in the rest of THIS file (TP, SL, trailing, position size, LLM/
  // Darwin tuning) are NEVER touched by the preset.
  // Built-in keys in strategy.example.json: "myself" (full manual control) |
  // "sniper" | "wait_for_dip" | "smart_money" | "degen" — add your own by
  // adding a new top-level key to strategy.json.
  "strategy": "myself",
  "screener": {
    // Max new candidates evaluated per screening cycle.
    "maxCandidatesPerCycle": 3,
    // Discovery source: 'gmgn' | 'dexscreener'. Note: the active strategy
    // currently always forces this to 'gmgn' when the config is built —
    // DexScreener only kicks in automatically as a fallback when GMGN
    // returns zero candidates for a cycle.
    "source": "gmgn",
    // Free rule-based gate before the LLM (src/screener/preScorer.js) — only takes
    // effect when llm.enabled (from strategy.json) is true (a no-op otherwise).
    "preScoreEnabled": true
  },
  "trading": {
    // Position size in native SOL — the ONLY sizing control.
    "buyAmount": 0.3,
    "slippageBps": 300,
    "maxPositions": 20,
    // Reject swaps worth less than this (USD).
    "minSwapUsd": 5,
    // Don't re-buy the same token within this window (minutes).
    "cooldownMinutes": 240,
    // Allow N closes+re-buys of the same token within cooldownMinutes
    // before cooldown actually blocks it. 1 = old behavior (blocks
    // immediately after the first close).
    "maxTradesBeforeCooldown": 5,
    "stopLossPct": -35,
    // Anti-glitch / flash-dump guard for stop loss: if a single monitor
    // tick shows a sudden drop >= slFlashDropPct AND breaches SL, the
    // close is delayed one tick for confirmation before executing.
    "slFlashDropPct": 40,
    // Dynamic stop-loss based on volatility proxy (|priceChange.h1| from DexScreener):
    // effective SL = clamp(-|h1| * multiplier, floorPct, ceilingPct). OPT-IN (default
    // OFF) — when active, SL can WIDEN beyond stopLossPct and Darwin-genome SL.
    "dynamicSl": {
      "enabled": false,
      "multiplier": 1.5,
      "floorPct": -55,
      "ceilingPct": -10,
      "minVolPct": 3,
      "maxVolPct": 40
    },
    // 0 = disabled. Force-close a position after this many minutes, regardless of PnL.
    "maxHoldMinutes": 0,
    // 0 = disabled. Force-close if PnL stuck within sidewaysPnlBandPct for this many minutes.
    "sidewaysTimeoutMinutes": 0,
    "sidewaysPnlBandPct": 2,
    // Re-check hard filters right before executing a buy (protects against stale/rugged
    // candidate between screening and execution). Applies to auto-buy AND manual /buy.
    "buyFreshnessCheck": true,
    "buyMaxRetries": 2,
    "buyRetryDelayMs": 2000,
    // Ignore price reads from pairs with liquidity below this (USD) —
    // near-zero-liquidity pairs are the main source of price glitches.
    "priceMinLiquidityUsd": 300,
    // Ignore a price update if it spikes more than this % in one tick.
    // 0 = disabled. Default 500% (6x).
    "priceAnomalySpikePct": 500
  },
  "tpLadder": [
    // gainPct = profit target %, sellPct = % of remaining position sold
    { "gainPct": 40, "sellPct": 30 },
    { "gainPct": 100, "sellPct": 40 },
    { "gainPct": 250, "sellPct": 50 }
  ],
  "trailing": {
    "enabled": true,
    // PRE-TP phase: trailing activates once peak profit reaches this %.
    "activateGainPct": 10,
    // Drop this % from peak → sell 100% (close).
    "trailPct": 5,
    // POST-TP phase (a tpLadder tier already hit): trailing is active
    // immediately; on trailPct drop from peak, sell everything except
    // moonbagPct (of the ORIGINAL position), which is moved to the
    // moonbag for long-term hold. 0 = no moonbag, sell all.
    "moonbagPct": 10
  },
  "monitor": {
    "intervalSec": 10,
    // Warn in logs if a position's price has been unavailable for more
    // than N seconds — may indicate a delisted/rugged token.
    "stalePriceWarnSec": 600,
    // On-chain balance safety check: auto-close a position if its
    // on-chain balance is 0 but it's still recorded as open. Runs at
    // most once per N seconds. 0 = disabled.
    "onchainReconcileSec": 60
  },
  "darwin": {
    // Whether Darwin is enabled at all, and whether it auto-evolves, are
    // strategy-owned — set darwinEnabled / autoEvolve per strategy in
    // strategy.json, not here. Everything below is global tuning that
    // applies whenever the active strategy has darwinEnabled: true.
    "populationSize": 8,
    // 0 = auto-evolve stays off even if the strategy enables Darwin; use
    // /evolve manually to see proposals — you decide when to apply them.
    "evolveEveryNTrades": 0,
    "mutationRate": 0.35,
    // Chance of using a non-best genome during screening (exploration).
    "exploreRate": 0.25,
    "minTradesForFitness": 3
  },
  "llm": {
    // Whether the LLM gate runs at all is strategy-owned (llmEnabled in
    // strategy.json) — set it there once you've configured an API key.
    // Everything below is global LLM tuning that applies whenever the
    // active strategy has llmEnabled: true.
    "provider": "openrouter",
    "model": "deepseek/deepseek-chat-v3-0324",
    // LLM only GATES buy/skip — it never sizes positions (always trading.buyAmount).
    "gateBuy": true,
    // action=buy but confidence below this → still rejected.
    "minConfidence": 0.35,
    // true = LLM error lets the token through; false = LLM error rejects it.
    "failOpen": true,
    // How many recent lessons get injected into the prompt.
    "maxLessons": 12,
    // Decision cache: "skip" verdict cached per token so LLM isn't asked again next
    // cycle if market conditions haven't moved much. Only active when llm.enabled.
    "decisionCacheEnabled": true,
    "decisionCacheSkipTtlMin": 30,
    // Candidates batched into one LLM call instead of one call per candidate.
    "batchSize": 5,
    // Allow the LLM to call tools (screen/buy/sell/positions) in chat.
    "tools": true
  },
  "telegram": {
    "notifyScreening": true,
    "notifyPriceMoves": false,
    // Screening loop interval (find new candidates), in minutes.
    "screeningcyclemin": 60,
    // Position report interval (balance + PnL notification), in minutes. 0 = disabled.
    "managecyclemin": 30
  }
}
