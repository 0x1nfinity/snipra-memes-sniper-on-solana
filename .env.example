# ===== Wallet =====
# Private key Solana (base58, dari Phantom/Solflare export)
# ⚠️ SECURITY: JANGAN commit file ini atau share private key.
# Hanya dibutuhkan untuk mode LIVE — mode paper tidak perlu.
SOLANA_PRIVATE_KEY=

# ===== RPC =====
# Gunakan dedicated RPC (Helius, QuickNode, Triton, dll) untuk production —
# public endpoint rate-limited dan tidak reliable untuk trading bot.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# Chat ID yang diizinkan mengontrol bot (dapatkan dari @userinfobot)
TELEGRAM_CHAT_ID=

# ===== LLM (pilih salah satu / keduanya) =====
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# DeepSeek direct: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ===== Opsional =====
# Jupiter API key (kalau pakai api.jup.ag berbayar; kosongkan untuk lite-api gratis)
JUPITER_API_KEY=

# GMGN API keys — comma-separated for sequential fallback.
# The FIRST key is also used for wallet tracking (wallet_activity + walletStats).
# Used by: src/screener/gmgn-discovery.js (discovery) + src/gmgn/openapi.js (wallet tracking)
# Format: "key1,key2,key3"
GMGN_API_KEYS=

# Override runtime mode — 'paper' or 'live'. Leave empty to auto-detect from data/.mode.
# Priority: SNIPRA_MODE > data/.mode file > default "paper"
SNIPRA_MODE=
# Verbosity log: debug | info | warn | error. Kosong = info.
LOG_LEVEL=
