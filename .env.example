# ===== Wallet =====
# Private key Solana (base58, dari Phantom/Solflare export)
# ⚠️ SECURITY: JANGAN commit file ini atau share private key.
# Hanya dibutuhkan untuk mode LIVE — mode paper tidak perlu.
SOLANA_PRIVATE_KEY=

# ===== RPC =====
# Gunakan dedicated RPC (Helius, QuickNode, Triton, dll) untuk production —
# public endpoint rate-limited dan tidak reliable untuk trading bot.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# Chat ID yang diizinkan mengontrol bot (dapatkan dari @userinfobot)
TELEGRAM_CHAT_ID=

# ===== LLM (pilih salah satu / keduanya) =====
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# DeepSeek direct: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ===== Opsional =====
# Jupiter API key (kalau pakai api.jup.ag berbayar; kosongkan untuk lite-api gratis)
JUPITER_API_KEY=

# GMGN API keys — DUA VARIABEL BERBEDA (jangan tertukar!):
#
# GMGN_API_KEY  (singular) — untuk wallet tracking: wallet_activity + wallet_stats
#   Dipakai oleh: src/gmgn/openapi.js (findActivityByTx, walletStats)
#   Butuh 1 key saja. Beli di gmgn.ai → Referral & API.
GMGN_API_KEY=

# GMGN_API_KEYS (plural) — untuk token discovery/screening: POST /v1/trenches
#   Dipakai oleh: src/screener/gmgn-discovery.js (discoverFromGmgn)
#   Multiple keys comma-separated untuk sequential fallback.
#   Format: "key1,key2,key3"
GMGN_API_KEYS=

# Paksa mode paper (override config.json "mode"): 1 = papertest, kosong = ikut config.json
# Prioritas mode: DRY_RUN=1 > SNIPRA_MODE > data/.mode file > default "paper"
DRY_RUN=
# Override mode tanpa DRY_RUN — 'paper' atau 'live'.
SNIPRA_MODE=
# Verbosity log: debug | info | warn | error. Kosong = info.
LOG_LEVEL=
