# ===== Wallet =====
# Solana private key (base58, from Phantom/Solflare export)
# ⚠️ SECURITY: Do NOT commit this file or share the private key.
# Only needed for LIVE mode — paper mode does not need it.
SOLANA_PRIVATE_KEY=

# ===== RPC =====
# Use a dedicated RPC (Helius, QuickNode, Triton, etc.) for production —
# public endpoints are rate-limited and unreliable for a trading bot.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# Allowed chat ID to control the bot (get yours from @userinfobot)
TELEGRAM_CHAT_ID=

# ===== LLM (pick one or both) =====
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# DeepSeek direct: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ===== Optional =====
# Jupiter API key (paid api.jup.ag; leave empty for free lite-api)
JUPITER_API_KEY=

# GMGN API keys — comma-separated for sequential fallback.
# The FIRST key is also used for wallet tracking (wallet_activity + walletStats).
# Used by: src/screener/gmgn-discovery.js (discovery) + src/gmgn/openapi.js (wallet tracking)
# Format: "key1,key2,key3"
GMGN_API_KEYS=

# Override runtime mode — 'paper' or 'live'. Leave empty to auto-detect from data/.mode.
# Priority: SNIPRA_MODE > data/.mode file > default "paper"
SNIPRA_MODE=
# Log verbosity: debug | info | warn | error. Empty = info.
LOG_LEVEL=
