# ===== Wallet =====
# Private key wallet Solana (base58, dari Phantom/Solflare export)
SOLANA_PRIVATE_KEY=

# ===== RPC =====
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# Chat ID yang diizinkan mengontrol bot (dapatkan dari @userinfobot)
TELEGRAM_CHAT_ID=

# ===== LLM (pilih salah satu / keduanya) =====
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# DeepSeek direct: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ===== Opsional =====
# Jupiter API key (kalau pakai api.jup.ag berbayar; kosongkan untuk lite-api gratis)
JUPITER_API_KEY=
# GMGN cooperation API key (executor alternatif Solana, butuh approval GMGN)
GMGN_API_KEY=
# Paksa mode paper (override config.json "mode"): 1 = papertest, kosong = ikut config.json
DRY_RUN=
