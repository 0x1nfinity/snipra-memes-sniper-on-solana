{
  "name": "snipra",
  "version": "2.0.0",
  "description": "Solana memecoin sniper. Screening, swap Jupiter/GMGN, TP ladder, trailing profit, Telegram, Darwin evolution, LLM analysis.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "DRY_RUN=1 node src/index.js",
    "screen": "node src/index.js --screen-once",
    "skill": "node src/skills/runner.js --skill-mode",
    "skill-dev": "DRY_RUN=1 node src/skills/runner.js --skill-mode",
    "setup": "node scripts/install.js",
    "test": "node --test test/*.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@solana/web3.js": "^0.0.3",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.0",
    "headroom-ai": "^0.22.4",
    "node-telegram-bot-api": "^1.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
