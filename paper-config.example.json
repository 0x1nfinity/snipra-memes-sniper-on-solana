// paper-config.example.json — TEMPLATE, not read by the bot.
//
// How to use:
//   1. Copy this file to `paper-config.json` in the project root.
//   2. Strip out the comment lines (JSON does not support comments —
//      this template uses them for documentation only; the real
//      paper-config.json must be valid JSON).
//   3. Adjust values, or leave as-is — the bot auto-creates
//      paper-config.json with these same defaults on first run if
//      it doesn't exist.
//
// paper-config.json ONLY overrides the fields below on top of
// live-config.json while running in paper mode. Every other setting
// (screener, llm, trailing, etc.) always follows live-config.json,
// even in paper mode — edit that file for anything not listed here.
{
  "paper": {
    // Starting virtual balance per chain, in native SOL.
    "startBalance": {
      "solana": 10
    }
  },
  "trading": {
    // Paper mode can safely run more/smaller concurrent positions
    // than live — override maxPositions and buyAmount here.
    "maxPositions": 2,
    "buyAmount": 0.04,
    // Simulated gas cost per swap in paper mode (native SOL, per chain).
    "paperGas": {
      "solana": 0.000005
    }
  }
}
