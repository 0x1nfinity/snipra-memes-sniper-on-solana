// config.live.example.json — TEMPLATE, not read by the bot.
//
// How to use:
//   1. Copy this file to `config.live.json` in the project root.
//   2. Strip out the comment lines (JSON does not support comments —
//      this template uses them for documentation only; the real
//      config.live.json must be valid JSON).
//   3. Adjust values to your strategy, or leave as-is and tune later
//      via Telegram `/set <path> <value>` (persists back to this file).
//   4. If you skip this step entirely, the bot auto-creates
//      config.live.json with these same defaults on first run.
//
// config.live.json is the single source of truth for ALL settings
// (screener, trading, llm, trailing, etc). config.paper.json only
// overrides a few paper-mode-specific fields on top of this file.
{
  "screener": {
    // Max new candidates evaluated per screening cycle.
    "maxCandidatesPerCycle": 3,
    // Which DexScreener discovery endpoints to pull candidates from.
    "sources": {
      "tokenProfiles": true,
      "boostsLatest": true,
      "boostsTop": true
    },
    "filters": {
      // ===== REQUIRED =====
      "minVolume24hUsd": 50000,
      "minAgeHours": 0.5,
      "maxAgeHours": 168,
      "minLiquidityUsd": 20000,
      "minMarketCapUsd": 100000,
      "maxMarketCapUsd": 20000000,
      "minHolders": 200,
      "minTraders24h": 300,
      // ===== ADDITIONAL =====
      "minBuySellRatio": 0.9,
      "maxPriceDropH1Pct": 25,
      "minVolLiqRatio": 0.5,
      "requireSocials": false,
      "blockHoneypot": true,
      "maxTop10Pct": 85,
      "strictSecurity": false
    },
    // Anti-top-buy entry guard, based on real price data.
    "entryGuard": {
      "enabled": true,
      "athPullbackPct": 30,
      "maxGainH1Pct": 150,
      "maxGainH24Pct": 400,
      "runThresholdPct": 200
    }
  },
  "trading": {
    // Position size in native SOL — the ONLY sizing control.
    "buyAmount": 0.3,
    "slippageBps": 300,
    "maxPositions": 20,
    // Reject swaps worth less than this (USD).
    "minSwapUsd": 5,
    // Don't re-buy the same token within this window (minutes).
    "cooldownMinutes": 240,
    // Allow N closes+re-buys of the same token within cooldownMinutes
    // before cooldown actually blocks it. 1 = old behavior (blocks
    // immediately after the first close).
    "maxTradesBeforeCooldown": 5,
    "stopLossPct": -35,
    // Anti-glitch / flash-dump guard for stop loss: if a single monitor
    // tick shows a sudden drop >= slFlashDropPct AND breaches SL, the
    // close is delayed one tick for confirmation before executing.
    "slFlashDropPct": 40,
    // Ignore price reads from pairs with liquidity below this (USD) —
    // near-zero-liquidity pairs are the main source of price glitches.
    "priceMinLiquidityUsd": 300,
    // Ignore a price update if it spikes more than this % in one tick.
    // 0 = disabled.
    "priceAnomalySpikePct": 500
  },
  "tpLadder": [
    // gainPct = profit target %, sellPct = % of remaining position sold.
    { "gainPct": 40, "sellPct": 30 },
    { "gainPct": 100, "sellPct": 40 },
    { "gainPct": 250, "sellPct": 50 }
  ],
  "trailing": {
    "enabled": true,
    // PRE-TP phase: trailing activates once peak profit reaches this %.
    "activateGainPct": 10,
    // Drop this % from peak → sell 100% (close).
    "trailPct": 5,
    // POST-TP phase (a tpLadder tier already hit): trailing is active
    // immediately; on trailPct drop from peak, sell everything except
    // moonbagPct (of the ORIGINAL position), which is moved to the
    // moonbag for long-term hold. 0 = no moonbag, sell all.
    "moonbagPct": 10
  },
  "monitor": {
    "intervalSec": 20,
    // Warn in logs if a position's price has been unavailable for more
    // than N seconds — may indicate a delisted/rugged token.
    "stalePriceWarnSec": 600,
    // On-chain balance safety check: auto-close a position if its
    // on-chain balance is 0 but it's still recorded as open. Runs at
    // most once per N seconds. 0 = disabled.
    "onchainReconcileSec": 60
  },
  "darwin": {
    "enabled": true,
    "populationSize": 8,
    "evolveEveryNTrades": 20,
    "mutationRate": 0.35,
    // Chance of using a non-best genome during screening (exploration).
    "exploreRate": 0.25,
    "minTradesForFitness": 3
  },
  "llm": {
    // Enable via `/set llm.enabled true` once you've set an API key.
    "enabled": false,
    "provider": "openrouter",
    "model": "deepseek/deepseek-chat-v3-0324",
    // LLM only GATES buy/skip — it never sizes positions (always trading.buyAmount).
    "gateBuy": true,
    // action=buy but confidence below this → still rejected.
    "minConfidence": 0.35,
    // true = LLM error lets the token through; false = LLM error rejects it.
    "failOpen": true,
    // How many recent lessons get injected into the prompt.
    "maxLessons": 12,
    // Allow the LLM to call tools (screen/buy/sell/positions) in chat.
    "tools": true
  },
  "telegram": {
    "notifyScreening": true,
    "notifyPriceMoves": false,
    // Screening loop interval (find new candidates), in minutes.
    "screeningcyclemin": 60,
    // Position report interval (balance + PnL notification), in minutes. 0 = disabled.
    "managecyclemin": 30
  }
}
